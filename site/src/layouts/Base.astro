---
// Every page: the prototype notice, the top bar and the footer.
import "../styles/global.css";
import { base } from "../lib/data.js";
const { title, description = "", accent = "var(--cloth-teal)", current = "", progress = false } = Astro.props;
const nav = [["chapters", "Chapters", ""], ["timeline", "Timeline", ""], ["bibliography", "Bibliography", "wide-only"]];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='4' fill='%231e6767'/><path d='M9 24V9m7 15V9m7 15V9' stroke='white' stroke-width='3' stroke-linecap='round'/></svg>" />
  </head>
  <body style={`--accent:${accent}`}>
    <div class="proto-bar"><b>Prototype</b>Chapter text drafted from the research notes; sources not yet checked at the archives. Images awaiting permission are marked.</div>
    <header class="topbar">
      <a class="wordmark" href={base("")}>A History of Tufting <i>· Tim Eads</i></a>
      <nav aria-label="Main">
        {nav.map(([href, label, cls]) => <a class={cls} href={base(href === "chapters" ? "" : href + "/")} aria-current={current === href ? "page" : undefined}>{label}</a>)}
      </nav>
      {progress && <span class="progress" aria-hidden="true"></span>}
    </header>
    <main><slot /></main>
    <footer class="foot">
      <span>A History of Tufting, by Tim Eads. A prototype built from the <a href="/rug-research/">Rug Research database</a>.</span>
      <span>Sources link to the institutions that hold them.</span>
    </footer>
    <script is:inline>
      // On narrow screens a note number opens its note under the line instead of jumping to the end.
      document.addEventListener("click", e => {
        const a = e.target.closest(".fn a");
        if (!a || !matchMedia("(max-width: 1100px)").matches) return;
        const note = a.closest(".fn").nextElementSibling;
        if (!note || !note.classList.contains("sidenote")) return;
        e.preventDefault();
        note.classList.toggle("open");
        a.setAttribute("aria-expanded", String(note.classList.contains("open")));
      });
    </script>
  </body>
</html>
