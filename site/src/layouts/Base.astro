---
// Every page: the board masthead, the prototype notice, and the foot.
import "../styles/global.css";
import { base, canonical, absolute } from "../lib/data.js";
import { BASE, INDEXABLE, RESEARCH_URL } from "../../site.config.mjs";
// For search and sharing: image (a picture's address), type ("article" for a chapter), scholar (Google Scholar's
// citation_ tags) and schema (structured data describing the page).
const { title, description = "", shade = "var(--cloth-teal)", current = "", progress = false, image = "", type = "website", scholar = null, schema = null } = Astro.props;
const url = canonical(Astro.url.pathname.slice(BASE.length));
const nav = [["", "Contents", "chapters", ""], ["timeline/", "Timeline", "timeline", ""], ["bibliography/", "Bibliography", "bibliography", ""]];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={INDEXABLE ? "index, follow" : "noindex"} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={url} />
    <meta property="og:site_name" content="A History of Tufting" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title.replace(/ · A History of Tufting$/, "")} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={url} />
    {image && <meta property="og:image" content={absolute(image)} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    {scholar && Object.entries(scholar).map(([k, v]) => <meta name={`citation_${k}`} content={v} />)}
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='3' fill='%231e2421'/><rect x='6' y='6' width='20' height='20' fill='%231e6767'/><path d='M6 10h20M6 14h20M6 18h20M6 22h20' stroke='%23000' stroke-opacity='.25'/></svg>" />
  </head>
  <body style={`--shade:${shade}`}>
    <header class="mast">
      <div class="in">
        <a class="wordmark" href={base("")}>A History of Tufting</a>
        <nav aria-label="Main">
          {nav.map(([href, label, key, cls]) => <a class={cls} href={base(href)} aria-current={current === key ? "page" : undefined}>{label}</a>)}
        </nav>
      </div>
      {progress && <span class="progress" aria-hidden="true"></span>}
    </header>
    <p class="notice"><b>Prototype.</b> Chapter text drafted from the research notes and not yet checked at the archives. Images awaiting permission are marked.</p>
    <main><slot /></main>
    <footer class="foot">
      <div class="in">
        <span>A History of Tufting, by Tim Eads. Built from the <a href={RESEARCH_URL}>Rug Research database</a>.</span>
        <span>Every source links to the institution that holds it.</span>
      </div>
    </footer>
    <script is:inline>
      // On narrow screens a note number opens its note under the line instead of jumping to the end.
      document.addEventListener("click", e => {
        const a = e.target.closest(".fn a");
        if (!a || a.closest(".aside") || !matchMedia("(max-width: 1100px)").matches) return;
        const note = a.closest(".fn").nextElementSibling;
        if (!note || !note.classList.contains("sidenote")) return;
        e.preventDefault();
        note.classList.toggle("open");
        a.setAttribute("aria-expanded", String(note.classList.contains("open")));
      });
    </script>
  </body>
</html>
