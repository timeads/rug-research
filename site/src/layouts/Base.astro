---
// Every page: the board masthead and the foot.
import "../styles/global.css";
import { base, canonical, absolute } from "../lib/data.js";
import { BASE, INDEXABLE, RESEARCH_URL } from "../../site.config.mjs";
// For search and sharing: image (a picture's address), type ("article" for a chapter), scholar (Google Scholar's
// citation_ tags) and schema (structured data describing the page). search={false} leaves the page out of
// the site search and hides the search button (the About page; the 404 page). indexed={false} keeps the
// button but leaves the page out of the results: the list pages (gallery, timeline, bibliography,
// directory) only repeat records that are each in the index themselves. searchKind sets the page's
// filter in the search ("Directory" for a record that is a directory entry).
const { title, description = "", shade = "var(--cloth-teal)", current = "", progress = false, image = "", type = "website", scholar = null, schema = null, search = true, searchKind = "", indexed = true } = Astro.props;
const url = canonical(Astro.url.pathname.slice(BASE.length));
// What kind of page this is, for the search's filters: Pagefind indexes <main> with this as its "kind".
const path = Astro.url.pathname.slice(BASE.length);
const kind = searchKind || (path.startsWith("records/") ? "Records" : path.startsWith("chapters/") || path === "" ? "Chapters" : path.startsWith("short-version") ? "Chapters"
  : ({ gallery: "Gallery", directory: "Directory", timeline: "Timeline", bibliography: "Bibliography" })[current] || "Other");
const nav = [["", "Chapters", "chapters", ""], ["gallery/", "Gallery", "gallery", ""], ["directory/", "Directory", "directory", ""], ["timeline/", "Timeline", "timeline", ""], ["bibliography/", "Bibliography", "bibliography", ""], ["about/", "About", "about", ""]];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={INDEXABLE ? "index, follow" : "noindex"} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={url} />
    <meta property="og:site_name" content="A History of Tufted Rugs" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title.replace(/ · A History of Tufted Rugs$/, "")} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={url} />
    {image && <meta property="og:image" content={absolute(image)} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    {scholar && Object.entries(scholar).map(([k, v]) => <meta name={`citation_${k}`} content={v} />)}
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='3' fill='%231e2421'/><rect x='6' y='6' width='20' height='20' fill='%231e6767'/><path d='M6 10h20M6 14h20M6 18h20M6 22h20' stroke='%23000' stroke-opacity='.25'/></svg>" />
  </head>
  <body style={`--shade:${shade}`}>
    <header class="mast">
      <div class="in">
        <a class="wordmark" href={base("")}>A History of Tufted Rugs</a>
        <nav aria-label="Main">
          {nav.map(([href, label, key, cls]) => <a class={cls} href={base(href)} aria-current={current === key ? "page" : undefined}>{label}</a>)}
          {search && <button class="search-open" type="button" aria-haspopup="dialog" aria-keyshortcuts="/" title="Search (press /)"><svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><circle cx="6.75" cy="6.75" r="4.75" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M10.4 10.4 14.5 14.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg><span>Search</span></button>}
        </nav>
      </div>
      {progress && <span class="progress" aria-hidden="true"></span>}
    </header>
    {search && indexed ? <main data-pagefind-body data-pagefind-filter={`kind:${kind}`}><slot /></main> : <main><slot /></main>}
    <footer class="foot">
      <div class="in">
        <span>A History of Tufted Rugs, by Tim Eads. Built from the <a href={RESEARCH_URL}>Rug Research database</a>.</span>
        <span>Every source links to the institution that holds it.</span>
      </div>
    </footer>
    {search && (
      <dialog class="search" aria-label="Search the book" data-index={base("pagefind/pagefind.js")} data-base={base("")}>
        <form class="search-bar" method="dialog" role="search">
          <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><circle cx="6.75" cy="6.75" r="4.75" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M10.4 10.4 14.5 14.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          <label class="vh" for="search-q">Search the chapters, records and directory</label>
          <input id="search-q" type="search" autocomplete="off" spellcheck="false" placeholder="Search chapters, records, the directory…" />
          <button class="search-x" type="submit" value="close">Close</button>
        </form>
        <div class="search-kinds" role="group" aria-label="Show results from">
          {["All", "Chapters", "Records", "Directory"].map((k, i) => <button type="button" class="chip" data-kind={i ? k : ""} aria-pressed={i ? "false" : "true"}>{k}</button>)}
        </div>
        <p class="search-status" role="status" aria-live="polite">Type a name, a place, a date or a word.</p>
        <ol class="search-results"></ol>
      </dialog>
    )}
    <script is:inline>
      // Site search: the dialog opens from the masthead button or the / key. Pagefind's index (built after
      // the site, into pagefind/) loads the first time it opens; results come in as you type.
      (() => {
        const dlg = document.querySelector("dialog.search"); if (!dlg) return;
        const input = dlg.querySelector("input"), list = dlg.querySelector(".search-results"), status = dlg.querySelector(".search-status");
        const chips = [...dlg.querySelectorAll(".search-kinds .chip")];
        let pf = null, kind = "", seq = 0, timer = 0;
        const load = async () => {
          if (pf) return pf;
          try { pf = await import(dlg.dataset.index); await pf.options({ baseUrl: dlg.dataset.base, excerptLength: 26, ranking: { pageLength: 0.15, termFrequency: 0.8 } }); pf.init(); }
          catch { status.textContent = "Search isn't available on this copy of the site."; pf = null; }
          return pf;
        };
        const open = () => { if (!dlg.open) { dlg.showModal(); input.select(); load(); } };
        document.querySelectorAll(".search-open").forEach(b => b.addEventListener("click", open));
        document.addEventListener("keydown", e => {
          if (e.key !== "/" || e.metaKey || e.ctrlKey || e.altKey) return;
          if (e.target.closest("input, textarea, select, [contenteditable]")) return;
          e.preventDefault(); open();
        });
        dlg.addEventListener("click", e => { if (e.target === dlg) dlg.close(); }); // a click on the backdrop
        const esc = s => String(s).replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
        const run = async () => {
          const q = input.value.trim(), mine = ++seq;
          if (!q) { list.innerHTML = ""; status.textContent = "Type a name, a place, a date or a word."; return; }
          const p = await load(); if (!p || mine !== seq) return;
          const res = await p.search(q, kind ? { filters: { kind } } : {});
          if (mine !== seq) return;
          const top = await Promise.all(res.results.slice(0, 30).map(r => r.data()));
          if (mine !== seq) return;
          status.textContent = res.results.length ? `${res.results.length} ${res.results.length === 1 ? "page" : "pages"}${res.results.length > 30 ? ", the first 30 shown" : ""}` : "Nothing found. Try fewer or different words.";
          list.innerHTML = top.map(d => {
            const k = (d.filters.kind || [])[0] || "";
            const title = (d.meta.title || "").replace(/ · A History of Tufted Rugs$/, "");
            const subs = (d.sub_results || []).filter(s => s.url !== d.url && s.title !== d.meta.title && s.title !== "Key dates").sort((a, b) => (b.weighted_locations || b.locations || []).length - (a.weighted_locations || a.locations || []).length).slice(0, 2);
            return `<li><a href="${esc(subs.length && k === "Chapters" ? subs[0].url : d.url)}"><span class="k">${esc(k)}</span><span class="t">${esc(title)}</span><span class="x">${d.excerpt}</span></a>${k === "Chapters" ? subs.map(s => `<a class="sub" href="${esc(s.url)}"><span class="t">${esc(s.title)}</span><span class="x">${s.excerpt}</span></a>`).join("") : ""}</li>`;
          }).join("");
        };
        input.addEventListener("input", () => { clearTimeout(timer); timer = setTimeout(run, 160); });
        chips.forEach(c => c.addEventListener("click", () => { kind = c.dataset.kind; chips.forEach(x => x.setAttribute("aria-pressed", String(x === c))); run(); input.focus(); }));
      })();
    </script>
    <script is:inline>
      // On narrow screens a note number opens its note under the line instead of jumping to the end.
      document.addEventListener("click", e => {
        const a = e.target.closest(".fn a");
        if (!a || a.closest(".aside") || !matchMedia("(max-width: 1100px)").matches) return;
        const note = a.closest(".fn").nextElementSibling;
        if (!note || !note.classList.contains("sidenote")) return;
        e.preventDefault();
        note.classList.toggle("open");
        a.setAttribute("aria-expanded", String(note.classList.contains("open")));
      });
    </script>
  </body>
</html>
