---
// The chapter's key dates on one thread, spaced by year; a list on narrow screens.
import { base } from "../lib/data.js";
const { items = [] } = Astro.props;
const years = items.map(m => parseInt(m.year, 10));
const lo = Math.min(...years), hi = Math.max(...years);
const x = y => `${((y - lo) / (hi - lo || 1)) * 90 + 1}%`;
---
<section class="milestones" aria-labelledby="key-dates">
  <h2 id="key-dates">Key dates</h2>
  <ol>
    {items.map((m, i) => <li style={`--x:${x(years[i])}`}><a href={base(`records/${m.record}/`)}><b>{m.year}</b>{m.label}</a></li>)}
  </ol>
</section>
