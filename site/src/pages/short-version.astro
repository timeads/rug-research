---
// The short version: the book on two printed sheets. Its text is src/text/short-version.md, which the
// research tool's Book view edits; this page lays it out (see lib/short-version.js for the format).
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { base, CHAPTER_CLOTH } from "../lib/data.js";
import { parseShortVersion, inline } from "../lib/short-version.js";
import raw from "../text/short-version.md?raw";

const entries = await getCollection("chapters");
const byNumber = Object.fromEntries(entries.map(e => [e.data.number, { n: e.data.number, title: e.data.title, slug: e.id, shade: `var(--cloth-${CHAPTER_CLOTH[e.data.researchChapter] || "grey"})` }]));
const { fm, sections } = parseShortVersion(raw);
for (const s of sections) for (const c of s.chapters || []) if (!byNumber[c.n]) throw new Error(`short-version.md: "### ${c.heading}" names no chapter`);
const title = fm.title || "The short version";
---
<Base title={`${title} · A History of Tufted Rugs`} description="A History of Tufted Rugs on two sheets: the argument of each of the thirteen chapters, and the dates that carry it." current="chapters" shade="var(--ink)">
  <article class="tldr">
    <header class="tldr-head">
      <p class="tldr-kicker">A History of Tufted Rugs · by Tim Eads</p>
      <h1>{title}</h1>
      {fm.lede && <p class="tldr-lede" set:html={inline(fm.lede)} />}
      <button class="tldr-print" type="button" onclick="window.print()">Print the two sheets</button>
    </header>

    {sections.map(s => {
      if (s.kind === "brief") return (
        <section class="tldr-brief"><h2>{s.heading}</h2>{s.paras.map(p => <p set:html={inline(p)} />)}</section>
      );
      if (s.kind === "part") return (
        <section class="tldr-part">
          <h2>{s.heading}</h2>
          <ol class="tldr-ch">
            {s.chapters.map(c => { const ch = byNumber[c.n]; return (
              <li style={`--shade:${ch.shade}`}>
                <a class="tldr-t" href={base(`chapters/${ch.slug}/`)}><span class="num">Chapter {ch.n}</span> {ch.title}</a>
                {c.paras.map(p => <p set:html={inline(p)} />)}
              </li>
            ); })}
          </ol>
        </section>
      );
      if (s.kind === "dates") return (
        <section class="tldr-dates"><h2>{s.heading}</h2><ol>{s.items.map(d => <li><b class="num">{d.when}</b> <Fragment set:html={inline(d.text)} /></li>)}</ol></section>
      );
      if (s.kind === "list") return (
        <section class="tldr-open"><h2>{s.heading}</h2><ul>{s.items.map(t => <li set:html={inline(t)} />)}</ul></section>
      );
      return <section class="tldr-open"><h2>{s.heading}</h2>{s.paras.map(p => <p set:html={inline(p)} />)}</section>;
    })}

    {fm.foot && <p class="tldr-foot" set:html={inline(fm.foot)} />}
  </article>
</Base>
