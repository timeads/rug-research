---
// A chapter: its wound shade and title, the opening photograph, key dates, the text with margin notes,
// then the notes in full and where the sources are held.
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Milestones from "../../components/Milestones.astro";
import WoundBand from "../../components/WoundBand.astro";
import Cite from "../../components/Cite.astro";
import { db, record, imageUrl, imageCleared, citation, base, canonical, absolute, CHAPTER_CLOTH, clothName } from "../../lib/data.js";

export async function getStaticPaths() {
  const chapters = await getCollection("chapters");
  return chapters.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, remarkPluginFrontmatter, headings } = await render(entry);
const notes = remarkPluginFrontmatter.notes || [];
const d = entry.data;
// "In this chapter": the key dates, the chapter's sections and the notes. Shown beside the text on wide screens.
const toc = [
  ...(d.milestones.length ? [{ id: "key-dates", text: "Key dates" }] : []),
  ...headings.filter(h => h.depth === 2).map(h => ({ id: h.slug, text: h.text })),
  { id: "notes", text: "Notes" }
];
const hero = d.hero ? record(d.hero.record) : null;
// The opening picture: the record's own image, or one of its gallery images; focus sets the crop.
const heroSrc = hero ? (d.hero.image != null && hero.images?.[d.hero.image]?.src) || hero.image : "";
const shade = `var(--cloth-${CHAPTER_CLOTH[d.researchChapter] || "grey"})`;
const years = d.milestones.length ? `${d.milestones[0].year}–${d.milestones.at(-1).year}` : "";
const words = (entry.body || "").replace(/<[^>]+>|\[@[^\]]+\]|^---[\s\S]*?---/g, " ").split(/\s+/).filter(Boolean).length;
const cited = [...new Set(notes.flatMap(n => n.refs.map(r => r.id)))].map(record);
const holders = Object.entries(cited.reduce((o, it) => { const k = it.type === "patent" ? "US patents" : it.institution || (it.type === "finding" ? "Research notes, not yet traced to a public source" : "Published sources"); o[k] = (o[k] || 0) + 1; return o; }, {})).sort((a, b) => b[1] - a[1]);
const most = holders[0]?.[1] || 1;
const verified = cited.filter(it => it.status === "verified").length;
// How search engines and Google Scholar read the chapter: by Tim Eads, a chapter of A History of Tufted Rugs.
const scholar = d.published ? { title: d.title, author: "Eads, Tim", publication_date: d.published, inbook_title: "A History of Tufted Rugs", language: "en" } : null;
const shareImage = heroSrc && hero && imageCleared(hero) ? imageUrl(heroSrc, 2400) : "";
const schema = {
  "@context": "https://schema.org", "@type": "Chapter", name: d.title, description: d.dek, position: d.number,
  url: canonical(`chapters/${entry.id}/`), author: { "@type": "Person", name: "Tim Eads" }, inLanguage: "en",
  image: shareImage ? absolute(shareImage) : undefined, datePublished: d.published,
  isPartOf: { "@type": "Book", name: "A History of Tufted Rugs", author: { "@type": "Person", name: "Tim Eads" }, url: canonical("") }
};
---
<Base title={`${d.title} · A History of Tufted Rugs`} description={d.dek} shade={shade} current="chapters" progress type="article" image={shareImage} scholar={scholar} schema={schema}>
  <article>
    <header class="ch-head">
      <div class="ch-band"><WoundBand shade={shade} n={d.number} height={72} /><p class="ch-label"><b class="num">Shade {d.number}</b><span>{clothName(CHAPTER_CLOTH[d.researchChapter] || "grey")}</span>{years && <span class="num">{years}</span>}</p></div>
      <h1 class="ch-title">{d.title}</h1>
      <p class="ch-dek">{d.dek}</p>
      <div class="ch-byline"><span>By <b>Tim Eads</b></span><span>{Math.max(1, Math.round(words / 230))} minute read</span><span><span class="num">{notes.length}</span> notes, <span class="num">{cited.length}</span> sources, <span class="num">{verified}</span> checked at the archive</span>{d.status !== "final" && <span>{d.status === "prototype" ? "Prototype draft" : "Draft"}</span>}</div>
    </header>
    {hero && <figure class="ch-hero">
      <img src={imageUrl(heroSrc, 2400)} alt={hero.title} referrerpolicy="no-referrer" fetchpriority="high" style={d.hero.focus ? `object-position:${d.hero.focus}` : undefined} />
      <figcaption><span>{d.hero.caption ?? hero.title} <a href={base(`records/${hero.id}/`)}>Source</a>{!imageCleared(hero) && <> <span class="pending">Permission pending</span></>}</span></figcaption>
    </figure>}
    {d.milestones.length > 0 && <Milestones items={d.milestones} />}
    <div class="reading">
    <nav class="toc" aria-label="In this chapter">
      <p>In this chapter</p>
      <ol>{toc.map(t => <li><a href={`#${t.id}`}>{t.text}</a></li>)}</ol>
    </nav>
    <div class="prose">
      <Content components={{ Cite }} />
    </div>
    <section class="endmatter">
      <div>
        <h2 id="notes">Notes</h2>
        <ol class="notes">
          {notes.map(n => <li id={`note-${n.n}`}><a class="n" href={`#ref-${n.n}`} aria-label={`Back to note ${n.n} in the text`}>{n.n}</a><span set:html={n.refs.map(r => `${citation(record(r.id), { loc: r.loc })} <a href="${base(`records/${r.id}/`)}">Record</a>`).join(" ")} /></li>)}
        </ol>
      </div>
      <div>
        <h2>Where the sources are</h2>
        <ul class="holders">
          {holders.map(([k, v]) => <li><span>{k}</span><b>{v}</b><span class="bar" style={`width:${Math.max(6, (v / most) * 100)}%`}></span></li>)}
        </ul>
        <a class="more" href={base("bibliography/")}>The full bibliography</a>
      </div>
    </section>
    </div>
  </article>
  <script is:inline>
    // Mark the section being read in "In this chapter": the last heading above the upper third of the screen.
    (() => {
      const links = [...document.querySelectorAll(".toc a")];
      const targets = links.map(a => document.getElementById(decodeURIComponent(a.hash.slice(1))));
      let queued = false;
      const mark = () => {
        queued = false;
        let current = -1;
        targets.forEach((t, i) => { if (t && t.getBoundingClientRect().top < innerHeight * 0.3) current = i; });
        links.forEach((a, i) => i === current ? a.setAttribute("aria-current", "location") : a.removeAttribute("aria-current"));
      };
      addEventListener("scroll", () => { if (!queued) { queued = true; requestAnimationFrame(mark); } }, { passive: true });
      mark();
    })();
  </script>
</Base>
