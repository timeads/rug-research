---
// One page per record: its picture (or a bookcloth plate), the facts, the citation and where it is cited.
import Base from "../../layouts/Base.astro";
import { db, cloth, imageUrl, imageCleared, publicDomainTag, citation, base } from "../../lib/data.js";
import { citedIndex } from "../../lib/cited.js";

export async function getStaticPaths() {
  return db().items.map(it => ({ params: { id: it.id }, props: { it } }));
}
const { it } = Astro.props;
// Chapters that cite this record, with the note numbers.
const citedIn = (await citedIndex())[it.id] || [];
const TYPE = { finding: "Research finding", patent: "Patent", company: "Company", object: "Object", image: "Image", archive: "Archive", article: "Article", book: "Book", event: "Event", film: "Film or audio", "trade-catalog": "Trade catalogue", tool: "Tool", "oral-history": "Oral history", institution: "Institution", yarn: "Yarn" };
const facts = [["Made by", it.creator], ["Date", it.date], ["Place", it.place], ["Held by", it.institution], ["Collection", it.collection], ["Number", it.identifier], ["Publisher", it.publisher], ["Materials", it.materials.join(", ")], ["Size", it.dimensions], ["Themes", it.themes.join(", ")]].filter(([, v]) => v);
const shade = cloth(it.themes[0]);
const img = it.image && !it.image.startsWith("idb:") ? it.image : "";
// More photos of the same thing (a tool, its box, its instructions): a strip under the picture.
const gallery = (Array.isArray(it.images) ? it.images : []).filter(g => g && g.src && !String(g.src).startsWith("idb:"));
const firstCaption = gallery.find(g => g.src === img)?.caption || "";
// For search results: what the source is, when, and who holds it.
const description = [`${TYPE[it.type] || "Source"}: ${it.title.replace(/^(REFUTED|UNVERIFIED|CORRECTION)\s*:\s*/i, "")}`, it.date, it.institution].filter(Boolean).join(", ") + ". A source for A History of Tufted Rugs, by Tim Eads.";
---
<Base title={`${it.title} · A History of Tufted Rugs`} description={description} shade={shade} image={img && imageCleared(it) ? imageUrl(img) : ""}>
  <div class={`rec ${img ? "" : "noimg"}`}>
    {img && <figure class="plate"><img id="plate-img" src={imageUrl(img, 1400)} alt={it.title} referrerpolicy="no-referrer" />
      {it.imageRole === "illustration" ? <figcaption>Illustration, not the item itself: {it.imageCaption || "a comparable item"}</figcaption>
        : gallery.length > 1 ? <figcaption id="plate-cap">{firstCaption || `Photo 1 of ${gallery.length}`}</figcaption> : null}
      {gallery.length > 1 && <ul class="rec-gallery" aria-label="More photos">{gallery.map((g, i) => <li><a href={imageUrl(g.src, 1400)} data-full={imageUrl(g.src, 1400)} data-cap={g.caption || `Photo ${i + 1} of ${gallery.length}`} aria-current={i === 0 ? "true" : undefined}><img src={imageUrl(g.src, 400)} alt={g.caption || `Photo ${i + 1}`} loading="lazy" referrerpolicy="no-referrer" /></a></li>)}</ul>}
    </figure>}
    <div class="rec-body">
      <div class="rec-id">
      <h1>{it.title}</h1>
      <p class="kind">{TYPE[it.type] || it.type} · {it.status === "verified" ? "checked at the source" : "not yet checked at the source"}{img && !imageCleared(it) && <> · <span class="pending">Image permission pending</span></>}{img && publicDomainTag(it) && <> · <span class="pd-tag">Image in the public domain</span></>}</p>
      <dl class="facts">{facts.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
      <div class="btns">
        {it.sourceUrl && <a class="btn primary" href={it.sourceUrl} rel="noopener">View at the source</a>}
        {citedIn.map(c => <a class="btn" href={base(`chapters/${c.slug}/#ref-${c.ns[0]}`)}>Cited in chapter {c.number}, note{c.ns.length > 1 ? "s" : ""} {c.ns.join(", ")}</a>)}
      </div>
      </div>
      <div class="rec-read">
      <h2>Cite this source</h2>
      <div class="cite-box" set:html={citation(it)} />
      {it.description && <><h2>Research notes</h2><p class="notes-raw">{it.description}</p></>}
      </div>
    </div>
  </div>
  {gallery.length > 1 && <script is:inline>
    // A photo in the strip shows in the main picture, with its caption.
    document.querySelector(".rec-gallery").addEventListener("click", e => {
      const a = e.target.closest("a[data-full]"); if (!a) return;
      e.preventDefault();
      document.getElementById("plate-img").src = a.dataset.full;
      const cap = document.getElementById("plate-cap"); if (cap) cap.textContent = a.dataset.cap;
      document.querySelectorAll(".rec-gallery a").forEach(x => x.toggleAttribute("aria-current", x === a));
    });
  </script>}
</Base>
