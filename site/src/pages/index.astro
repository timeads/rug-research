---
// The cover: the title, then the history as one shade card of thirteen chapters.
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import WoundBand from "../components/WoundBand.astro";
import { db, base, canonical, CHAPTER_CLOTH, chapterYears, fmtYear, clothName } from "../lib/data.js";

const entries = await getCollection("chapters");
const published = Object.fromEntries(entries.map(e => [e.data.researchChapter, e.id]));
// A published chapter is listed under its own title, not the research draft's.
const titles = Object.fromEntries(entries.map(e => [e.data.researchChapter, e.data.title]));
// A finished chapter shows the span of its own key dates; one in preparation, the span of its evidence.
const spans = Object.fromEntries(entries.filter(e => e.data.milestones.length).map(e => [e.data.researchChapter, `${e.data.milestones[0].year}–${e.data.milestones.at(-1).year}`]));
const { chapters, items } = db();
const rows = chapters.map((c, i) => {
  const ys = chapterYears(c);
  return { n: i + 1, title: titles[c.id] || c.name, cloth: clothName(CHAPTER_CLOTH[c.id] || "grey"), shade: `var(--cloth-${CHAPTER_CLOTH[c.id] || "grey"})`, years: spans[c.id] || (ys ? `${fmtYear(ys[0])}–${fmtYear(ys[1])}` : ""), slug: published[c.id] };
});
const ready = rows.filter(r => r.slug).length;
// The history as a book, with the chapters that can be read so far.
const schema = {
  "@context": "https://schema.org", "@type": "Book", name: "A History of Tufted Rugs", url: canonical(""), inLanguage: "en",
  author: { "@type": "Person", name: "Tim Eads" },
  hasPart: rows.filter(r => r.slug).map(r => ({ "@type": "Chapter", name: r.title, position: r.n, url: canonical(`chapters/${r.slug}/`) }))
};
const dated = items.filter(x => x.dateStart != null).length;
const sources = items.filter(x => ["book", "article", "archive", "trade-catalog", "patent", "film", "oral-history"].includes(x.type)).length;
---
<Base title="A History of Tufted Rugs" description="A history of tufted rugs in thirteen chapters, from needle-made pile to the tufting gun and the robot, by Tim Eads." current="chapters" schema={schema}>
  <section class="cover">
    <h1>A History of Tufted Rugs</h1>
    <p class="scope">From needle-made pile and candlewick spreads to the broadloom mills of Dalton, the hand-held gun and the robot, told from patents, trade papers, archives and the objects themselves.</p>
    <p class="by">By Tim Eads</p>
  </section>
  <section class="card" aria-labelledby="contents">
    <div class="card-sheet">
      <div class="card-head"><h2 id="contents">Chapters</h2><span>{ready === rows.length ? `${ready} chapters` : `${ready} ${ready === 1 ? "chapter" : "chapters"} ready to read, ${rows.length - ready} in preparation`}</span></div>
      <ol class="shades">
        {rows.map(r => {
          const label = <span class="no"><b class="num">Shade {r.n}</b><span>{r.cloth}</span></span>;
          const text = <span class="tx"><span class="t">{r.title}</span><span class="yrs num">{r.years}</span></span>;
          return (
            <li style={`--shade:${r.shade}`}>
              {r.slug
                ? <a class="shade-row" href={base(`chapters/${r.slug}/`)}><WoundBand shade={r.shade} n={r.n} height={44} />{label}{text}<span class="st">Read the chapter</span></a>
                : <div class="shade-row soon"><WoundBand shade={r.shade} n={r.n} height={44} />{label}{text}<span class="st">In preparation</span></div>}
            </li>
          );
        })}
      </ol>
    </div>
  </section>
  <nav class="also" aria-label="Reference">
    <a href={base("timeline/")}><b>Timeline</b><span>All {dated} dated records, era by era, from Egyptian tapestry to the robot studio.</span></a>
    <a href={base("bibliography/")}><b>Bibliography</b><span>{sources} sources: archives, patents, trade literature, films, books and articles.</span></a>
  </nav>
</Base>
