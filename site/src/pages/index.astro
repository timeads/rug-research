---
// The cover: the title, the chapters as book spines on a shelf, and the ways in.
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { db, base } from "../lib/data.js";

const published = Object.fromEntries((await getCollection("chapters")).map(e => [e.data.researchChapter, e.id]));
// Bookcloth for each chapter, and a slightly uneven shelf.
const CLOTH = { "ch-processes": "wheat", "ch-before-machine": "oxblood", "ch-woven": "navy", "ch-dalton-bedspreads": "rose", "ch-machine": "ochre", "ch-nylon": "teal", "ch-abroad": "indigo", "ch-china": "plum", "ch-gun": "rust", "ch-india": "umber", "ch-today": "jade", "ch-cnc": "slate", "ch-hobby": "moss" };
const HEIGHTS = [22, 23.5, 21, 24, 22.5, 25, 21.5, 23, 24.5, 21, 22, 23.5, 20.5];
const { chapters, items, eras } = db();
const shelf = chapters.map((c, i) => ({ id: c.id, n: i + 1, title: c.name.split(":")[0], full: c.name, cloth: CLOTH[c.id] || "grey", h: HEIGHTS[i % HEIGHTS.length], slug: published[c.id] }));
const dated = items.filter(x => x.dateStart != null).length;
const sources = items.filter(x => ["book", "article", "archive", "trade-catalog", "patent", "film", "oral-history"].includes(x.type)).length;
---
<Base title="A History of Tufting" description="A history of tufting, from needle-made pile to the tufting gun and the robot, by Tim Eads." current="chapters">
  <section class="cover">
    <div>
    <span class="label">A history in thirteen chapters</span>
    <h1>A History <i>of</i><br />Tufting</h1>
    <p class="sub">From needle-made pile and candlewick spreads to the broadloom mills of Dalton, the hand-held gun and the robot.</p>
    <p class="by">By Tim Eads · Tuft the World</p>
    </div>
    <figure class="cover-art">
      <a href={base("records/pat-us463548a/")}><img src="/rug-research/images/patents/US463548-1.png" alt="Patent drawing of Ebenezer Ross's two-handled turfing implement, 1891" /></a>
      <figcaption>Ebenezer Ross, “Turfing Implement,” US patent 463,548, 1891</figcaption>
    </figure>
  </section>
  <div class="shelf-head"><span class="label">Chapters</span><span class="label">1 of {shelf.length} ready to read</span></div>
  <nav class="shelf" aria-label="Chapters">
    {shelf.map(s => s.slug
      ? <a class="spine live" href={base(`chapters/${s.slug}/`)} style={`--c:var(--cloth-${s.cloth});--h:${s.h}rem`} title={s.full}><span class="no">{s.n}</span><span class="t">{s.title}</span><span class="st">Read</span></a>
      : <span class="spine soon" style={`--c:var(--cloth-${s.cloth});--h:${s.h}rem`} title={`${s.full} (in preparation)`}><span class="no">{s.n}</span><span class="t">{s.title}</span><span class="st">Soon</span></span>)}
  </nav>
  <section class="doors">
    <a class="door" href={base("chapters/nylon/")}><span class="label">Chapter 6 · Read now</span><h2>Nylon and the broadloom boom</h2><p>How a DuPont fibre and a Dalton machine made wall-to-wall carpet cheap, and how it was sold.</p></a>
    <a class="door" href={base("timeline/")}><span class="label">Timeline</span><h2>{dated} dated moments</h2><p>From Egyptian tapestry to today, in {eras.length} eras, filtered by theme.</p></a>
    <a class="door" href={base("bibliography/")}><span class="label">Bibliography</span><h2>{sources} sources</h2><p>Archives, patents, trade literature, films, books and articles, each linked to where it is held.</p></a>
  </section>
</Base>
