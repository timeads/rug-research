---
// The cover: the title, then the history as one shade card of thirteen chapters.
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import WoundBand from "../components/WoundBand.astro";
import { db, base, CHAPTER_CLOTH, chapterYears, fmtYear } from "../lib/data.js";

const published = Object.fromEntries((await getCollection("chapters")).map(e => [e.data.researchChapter, e.id]));
const { chapters, items } = db();
const rows = chapters.map((c, i) => {
  const ys = chapterYears(c);
  return { n: i + 1, title: c.name, shade: `var(--cloth-${CHAPTER_CLOTH[c.id] || "grey"})`, years: ys ? `${fmtYear(ys[0])}–${fmtYear(ys[1])}` : "", slug: published[c.id] };
});
const ready = rows.filter(r => r.slug).length;
const dated = items.filter(x => x.dateStart != null).length;
const sources = items.filter(x => ["book", "article", "archive", "trade-catalog", "patent", "film", "oral-history"].includes(x.type)).length;
---
<Base title="A History of Tufting" description="A history of tufting in thirteen chapters, from needle-made pile to the tufting gun and the robot, by Tim Eads." current="chapters">
  <section class="cover">
    <h1>A History of Tufting</h1>
    <p class="scope">From needle-made pile and candlewick spreads to the broadloom mills of Dalton, the hand-held gun and the robot, told from patents, trade papers, archives and the objects themselves.</p>
    <p class="by">By Tim Eads</p>
  </section>
  <section class="card" aria-labelledby="contents">
    <div class="card-sheet">
      <div class="card-head"><h2 id="contents">Contents</h2><span>{ready} of {rows.length} chapters ready to read</span></div>
      <ol class="shades">
        {rows.map(r => (
          <li style={`--shade:${r.shade}`}>
            {r.slug
              ? <a class="shade-row" href={base(`chapters/${r.slug}/`)}><WoundBand shade={r.shade} n={r.n} height={44} /><span class="no">{String(r.n).padStart(2, "0")}</span><span><span class="t">{r.title}</span><span class="yrs">{r.years}</span></span><span class="st">Read the chapter</span></a>
              : <div class="shade-row soon"><WoundBand shade={r.shade} n={r.n} height={44} /><span class="no">{String(r.n).padStart(2, "0")}</span><span><span class="t">{r.title}</span><span class="yrs">{r.years}</span></span><span class="st">In preparation</span></div>}
          </li>
        ))}
      </ol>
    </div>
  </section>
  <nav class="also" aria-label="Reference">
    <a href={base("timeline/")}><b>Timeline</b><span>All {dated} dated records, era by era, from Egyptian tapestry to the robot studio.</span></a>
    <a href={base("bibliography/")}><b>Bibliography</b><span>{sources} sources: archives, patents, trade literature, films, books and articles.</span></a>
  </nav>
</Base>
